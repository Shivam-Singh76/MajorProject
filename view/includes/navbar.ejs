<style>
  .btn-search{
    background-color: red;
    color: #fff;
    border-radius: 25px;
    padding: 0 1rem 0 1rem;
  }
  .btn-search:hover{
    background-color: #fe424d;
    color: #fff;
  }
  .btn-search i{
    display: inline;
    margin-right: 0.5rem;
  }
</style>

<nav class="navbar navbar-expand-lg bg-white border-bottom sticky-top px-3">
  <div class="container-fluid">

    <!-- Brand logo -->
    <a class="navbar-brand" href="/listings">
      <i class="fa-regular fa-compass"></i>
    </a>

    <!-- Navbar links -->
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav">
        <li class="nav-item">
          <a class="nav-link" href="/listings">Home</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/listings">All Listings</a>
        </li>
      </ul>

      <%# Sirf login user ko search bar dikhao %>
      <% if(typeof currUser !== 'undefined' && currUser) { %>
        <form class="d-flex mx-auto" role="search" action="/listings" method="GET">
          <input 
            class="form-control me-2" 
            type="search" 
            name="search" 
            placeholder="Search destination"
            value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
          />
          <button class="btn btn-search" type="submit">
            <i class="fa-solid fa-magnifying-glass"></i> Search
          </button>
        </form>
      <% } else { %>
        <a href="/login" class="btn btn-search mx-auto">
          <i class="fa-solid fa-magnifying-glass"></i> Search
        </a>
      <% } %>

    </div>

    <ul class="navbar-nav ms-auto">
      <a class="nav-link" href="/listings/new">Airbnb your home</a>
      <% if(typeof currUser === 'undefined' || !currUser) { %>
        <li class="nav-item">
          <a class="nav-link" href="/signup"><b>Signup</b></a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/login"><b>Login</b></a>
        </li>
      <% } %>
      <% if(typeof currUser !== 'undefined' && currUser) { %>
        <li class="nav-item">
          <a class="nav-link" href="/logout"><b>Logout</b></a>
        </li>
      <% } %>
    </ul>

  </div>
</nav>