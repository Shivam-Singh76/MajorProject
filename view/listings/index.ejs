<%# Boilerplate layout use karta hai — navbar, footer automatically include hote hain %>
<% layout("/layouts/boilerplate") %> 
<style>
  #filters{
    display:flex;
    flex-wrap: wrap;
    align-items: center;
  }
  .filter{
    text-align: center;
    margin-right: 2rem;
    margin: 1rem;
    opacity: 0.7;
    text-decoration: none;
    color: inherit;
  }
  .filter:hover{
    opacity: 1;
    cursor: pointer;
  }
  .filter.active-filter{
    opacity: 1;
    border-bottom: 2px solid black;
    font-weight: bold;
  }
  .tax-info{
    display: none;
  }
  .tax-toggle{
    border: 1px solid black;
    border-radius: 1rem;
    height: 3.25rem;
    padding: 1rem;
    margin-left: 5rem;
    display: flex;
    align-items: center;
  }
</style>

<div id="filters">
  <a href="/listings?category=trending" class="filter <%= currCategory === 'trending' ? 'active-filter' : '' %>">
    <div><i class="fa-solid fa-fire"></i></div>
    <p>Trending</p>
  </a>
  <a href="/listings?category=rooms" class="filter <%= currCategory === 'rooms' ? 'active-filter' : '' %>">
    <div><i class="fa-solid fa-bed"></i></div>
    <p>Rooms</p>
  </a>
  <a href="/listings?category=iconic cities" class="filter <%= currCategory === 'iconic cities' ? 'active-filter' : '' %>">
    <div><i class="fa-solid fa-mountain-city"></i></div>
    <p>Iconic Cities</p>
  </a>
  <a href="/listings?category=mountains" class="filter <%= currCategory === 'mountains' ? 'active-filter' : '' %>">
    <div><i class="fa-solid fa-mountain"></i></div>
    <p>Mountains</p>
  </a>
  <a href="/listings?category=castles" class="filter <%= currCategory === 'castles' ? 'active-filter' : '' %>">
    <div><i class="fa-brands fa-fort-awesome"></i></div>
    <p>Castles</p>
  </a>
  <a href="/listings?category=amazing pool" class="filter <%= currCategory === 'amazing pool' ? 'active-filter' : '' %>">
    <div><i class="fa-solid fa-person-swimming"></i></div>
    <p>Amazing pool</p>
  </a>
  <a href="/listings?category=camping" class="filter <%= currCategory === 'camping' ? 'active-filter' : '' %>">
    <div><i class="fa-solid fa-campground"></i></div>
    <p>Camping</p>
  </a>
  <a href="/listings?category=farms" class="filter <%= currCategory === 'farms' ? 'active-filter' : '' %>">
    <div><i class="fa-solid fa-tractor"></i></div>
    <p>Farms</p>
  </a>
  <a href="/listings?category=arctic" class="filter <%= currCategory === 'arctic' ? 'active-filter' : '' %>">
    <div><i class="fa-regular fa-snowflake"></i></div>
    <p>Arctic</p>
  </a>
  <a href="/listings?category=dome" class="filter <%= currCategory === 'dome' ? 'active-filter' : '' %>">
    <div><i class="fa-solid fa-igloo"></i></div>
    <p>Dome</p>
  </a>
  <a href="/listings?category=boat" class="filter <%= currCategory === 'boat' ? 'active-filter' : '' %>">
    <div><i class="fa-solid fa-sailboat"></i></div>
    <p>Boat</p>
  </a>
  <div class="tax-toggle">
    <div class="form-check-reverse form-switch">
      <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
      <label class="form-check-label" for="switchCheckDefault">Display Taxes</label>
    </div>
  </div>
</div>

<%# Saari listings grid mein dikhata hai %>
<div class="container-fluid px-4 mt-4">
  <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 g-4">

    <% for(let listing of allListings){ %>
      <div class="col">
        <a href="/listings/<%= listing._id %>" style="text-decoration: none; color: inherit;">
          <div class="card h-100 listing-card" style="border-radius: 12px; border: none;">

            <div style="overflow: hidden; border-radius: 1rem; height: 300px;">
              <img
                src="<%= (listing.image && listing.image.url) ? listing.image.url : 'https://images.unsplash.com/photo-1506905925346-21bda4d32df4' %>"
                class="card-img-top"
                alt="<%= listing.title %>"
              >
            </div>

            <div class="card-body px-1">
              <h5 class="card-title fw-bold mb-1"><%= listing.title || "No Title" %></h5>
              <p class="mb-0">
                &#8377;<%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %>
                <span class="text-muted" style="font-size: 0.9rem;">/ night</span>
                <i class="tax-info"> +18% GST</i>
              </p>
            </div>

          </div>
        </a>
      </div>
    <% } %>

  </div>

  <%# Agar koi listing na mile %>
  <% if(allListings.length === 0) { %>
    <div class="text-center mt-5">
      <h4>NoT Found "<%= searchQuery %>"Try correct😔</h4>
      <a href="/listings" class="btn btn-dark mt-2">See All listing</a>
    </div>
  <% } %>

</div>

<script>
  let taxSwitch = document.getElementById("switchCheckDefault");
  taxSwitch.addEventListener("change", () => {
    let taxInfo = document.getElementsByClassName("tax-info");
    for (let info of taxInfo) {
      if (info.style.display != "inline") {
        info.style.display = "inline";
      } else {
        info.style.display = "none";
      }
    }
  });
</script>